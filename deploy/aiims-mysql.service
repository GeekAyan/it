[Unit]
Description=MySQL 8.4 - AIIMS app instance (port 3307)
Documentation=https://dev.mysql.com/doc/
After=network.target

[Service]
Type=simple
User=aiims
Group=aiims
ExecStart=/usr/sbin/mysqld --defaults-file=/etc/mysql/aiims.cnf
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
Restart=on-failure
RestartSec=10

# First start after --initialize can take a while while InnoDB sets itself up.
TimeoutStartSec=300
TimeoutStopSec=60

LimitNOFILE=65535

# Modest hardening; keeps the instance from writing outside its own tree.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target