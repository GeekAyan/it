# =====================================================================
#  Secrets for aiims-app.service  (installed as /opt/aiims/aiims.env)
#
#  On the server:
#      cp deploy/aiims.env.example /opt/aiims/aiims.env
#      nano /opt/aiims/aiims.env
#      chmod 600 /opt/aiims/aiims.env && chown aiims:aiims /opt/aiims/aiims.env
#
#  This file is NEVER in git and NEVER inside the jar. It is read by
#  systemd's EnvironmentFile directive, so no shell quoting is needed.
# =====================================================================

# --- Database (second MySQL instance on port 3307) ---------------------
# Do NOT use root here. This user only has rights on the eventdb schema.
DB_URL=jdbc:mysql://127.0.0.1:3307/eventdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=aiims
DB_PASSWORD=

# --- SMTP --------------------------------------------------------------
# MAIL_PASSWORD must be a Google App Password, not the account password.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- JVM ---------------------------------------------------------------
JAVA_OPTS=-Xms256m -Xmx768m