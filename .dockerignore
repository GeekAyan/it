# ---- build context hygiene ---------------------------------------------
# Keep the build context small and fast
target/
uploads/
backups/
logs/
.git/
.gitignore
.github/
.vscode/
.mvn/
mvnw
mvnw.cmd
HELP.md
*.log
hs_err*

# ---- NEVER bake secrets into the image ---------------------------------
# application-local.properties holds a plaintext DB + Gmail password and is
# git-ignored. Excluding it here guarantees the jar is built purely from
# application.properties, which reads ${DB_URL} etc. from the environment.
src/main/resources/application-local.properties
application-local.properties
.env
*.env