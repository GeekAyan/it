# =====================================================================
#  Copy this file to .env on the server and fill in the blanks:
#      cp .env.example .env && nano .env && chmod 600 .env
#  .env is git-ignored and excluded from the Docker build context.
#  NEVER commit the filled-in copy.
# =====================================================================

# --- MySQL container ----------------------------------------------------
# Password for the MySQL "root" account inside the container.
MYSQL_ROOT_PASSWORD=

# Password for the dedicated "aiims" application user (MYSQL_USER above).
DB_PASSWORD=

# --- SMTP (Gmail app password, not the account password) ---------------
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Application --------------------------------------------------------
# Bump this on every release: it is the image tag used for rollback.
APP_TAG=1.0.0

# JVM heap. ~768m is plenty for this workload.
JAVA_OPTS=-Xms256m -Xmx768m